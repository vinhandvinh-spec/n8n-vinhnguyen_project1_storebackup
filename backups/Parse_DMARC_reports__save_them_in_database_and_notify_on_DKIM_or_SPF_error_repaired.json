      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n  // Kiểm tra nếu item có chứa file nhị phân attachment_0\n  if (item.binary && item.binary.attachment_0) {\n    const fileName = item.binary.attachment_0.fileName || '';\n    \n    // Kiểm tra xem file có kết thúc bằng đuôi .rar không (không phân biệt chữ hoa/thường)\n    if (/\\.rar$/i.test(fileName)) {\n      // Đổi đuôi tên file từ .rar thành .zip\n      item.binary.attachment_0.fileName = fileName.replace(/\\.rar$/i, '.zip');\n      item.binary.attachment_0.fileExtension = 'zip';\n      item.binary.attachment_0.mimeType = 'application/zip';\n    }\n  }\n}\n\nreturn $input.all();"
