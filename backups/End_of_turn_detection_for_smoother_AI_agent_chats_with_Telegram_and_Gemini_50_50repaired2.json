      "id": "fbececb4-406b-4bf7-b2f1-8dbb8f20d2e2",
      "name": "Respond to User",
      "type": "n8n-nodes-base.telegram",
      "position": [
        3664,
        624
      ],
      "webhookId": "c095b0ea-c349-4ab7-8b16-efa5f4c22299",
      "typeVersion": 1.2,
      "credentials": {
        "telegramApi": {
          "id": "JNZRFUkL5kKbrz0g",
          "name": "Telegram account"
        }
