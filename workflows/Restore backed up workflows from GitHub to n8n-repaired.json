    {
      "parameters": {
        "operation": "create",
        "workflowObject": "={{ \n  (() => {\n    // 1. Lấy dữ liệu content (nếu là String thì parse về Object để xử lý)\n    let rawContent = $('Set name and content').item.json.content;\n    let data = typeof rawContent === 'string' ? JSON.parse(rawContent) : rawContent;\n\n    // 2. Xóa thuộc tính binaryMode gây lỗi schema nếu có\n    if (data && data.settings && data.settings.binaryMode) {\n      delete data.settings.binaryMode;\n    }\n\n    // 3. Chuyển Object ngược lại thành Chuỗi JSON\n    return JSON.stringify(data);\n  })()\n}}",
