    {
      "parameters": {
        "functionCode": "// Dành cho node Function (n8n v1/v2)\nreturn items.map(item => {\n  const j = item.json || {};\n  \n  // Trích xuất link từ Google Sheets\n  const rawUrl = String(j['Upload Report File'] || j['Upload File'] || '');\n  const match = rawUrl.match(/[-\\w]{25,}/);\n  const fileId = match ? match[0] : null;\n\n  return {\n    json: {\n      reporter: j['reporter'] || j['Reporter Name'] || null,\n      category: j['category'] || j['Report Category'] || null,\n      timestamp: j['timestamp'] || new Date().toISOString(),\n      folder_id: fileId,\n      email: j['email'] || j['Email Address'] || null,\n      description: j['description'] || j['Description'] || null,\n    }\n  };\n});"
      },
      "id": "ba6a2d4c-f548-446f-ab24-20c518e06f86",
